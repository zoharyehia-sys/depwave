{
  "name": "depwave",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "author": "Zohar Yehia",
  "description": "Test-impact analysis for JS/TS monorepos: run the tests your change can actually reach, and see why each one was selected.",
  "keywords": [
    "test-impact-analysis",
    "test-selection",
    "monorepo",
    "dependency-graph",
    "ast",
    "tree-sitter",
    "typescript",
    "ci"
  ],
  "homepage": "https://github.com/zoharyehia-sys/depwave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoharyehia-sys/depwave.git"
  },
  "bugs": "https://github.com/zoharyehia-sys/depwave/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "depwave": "./dist/depwave.mjs"
  },
  "files": [
    "dist/depwave.mjs",
    "grammars",
    "CHANGELOG.md",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node bundle.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@depwave/cache": "workspace:*",
    "@depwave/core": "workspace:*",
    "@depwave/git": "workspace:*",
    "@depwave/parser": "workspace:*",
    "@depwave/reporters": "workspace:*",
    "@depwave/resolver": "workspace:*",
    "@depwave/workspace": "workspace:*",
    "clipanion": "4.0.0-rc.4",
    "esbuild": "^0.28.2",
    "saxes": "6.0.0",
    "typanion": "^3.14.0"
  }
}
